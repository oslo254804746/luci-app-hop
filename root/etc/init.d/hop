#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043

USE_PROCD=1
START=95
STOP=10

CORE=/etc/hop/core/hop-server
CORE_MANAGER=/usr/share/hop/hop-core

start_service() {
	local auto_download config_path enabled stderr stdout

	config_load hop
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get config_path main config_path /etc/hop/config.toml
	config_get_bool auto_download main auto_download 1
	config_get_bool stdout main log_stdout 1
	config_get_bool stderr main log_stderr 1

	if [ ! -x "$CORE" ]; then
		if [ "$auto_download" -ne 1 ]; then
			logger -t hop "Hop core is not installed; run '$CORE_MANAGER install'"
			return 1
		fi
		logger -t hop "Hop core is not installed; downloading the verified release asset"
		"$CORE_MANAGER" ensure || return 1
	fi

	mkdir -p /var/lib/hop /tmp/hop
	chown hop:hop /var/lib/hop /tmp/hop

	procd_open_instance hop
	procd_set_param command "$CORE" --config "$config_path" serve
	procd_set_param user hop
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="4096 4096"
	procd_set_param file "$config_path"
	procd_set_param stdout "$stdout"
	procd_set_param stderr "$stderr"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger hop
}

reload_service() {
	restart
}
